        {
          "name": "Codex APP 会话远程控制（Desktop IPC）",
          "nameEn": "Codex APP remote control (Desktop IPC)",
          "key": "codex_app_control",
          "support": {
            "claude": "no",
            "codex": "experimental",
            "opencode": "no",
            "kimi": "no",
